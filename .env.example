# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public frontend URL (OAuth redirects, emails, CORS allowlist).
APP_URL="http://localhost:3000"
# Public Railway API custom domain (used to distinguish platform traffic from customer hostnames).
API_URL="http://localhost:3000"

# Extra browser origins allowed to call the API (comma-separated).
# Example production: CORS_ORIGINS="https://keylink360.mindflo.today,https://www.keylink360.mindflo.today"
CORS_ORIGINS=""

# Auth
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Expose OTP/verification tokens in API responses (dev only). Set false in production.
AUTH_EXPOSE_TOKENS="true"
# Seed / repair demo user keylink360@gmail.com / keyslink3601234.
# Default is ON (even in production) so live login keeps working after redeploys.
# Set "false" only if you want to disable the demo account entirely.
AUTH_SEED_DEMO="true"
# Allow email-prompt OAuth when Google/GitHub env vars are missing (dev only).
AUTH_ALLOW_DEV_OAUTH="true"
# Require email verification before login.
# unset = auto (required only when SMTP_* is configured)
# false = new users can register and sign in immediately (recommended until SMTP is ready)
# true  = always require verification email
# AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Supabase (Railway backend). Run supabase/schema.sql once in SQL Editor.
# Then: npm run migrate:supabase  (uploads data-store.json → all tables)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Production custom domains — root domains and subdomains
#
# Root domain (yourbrand.com): A record @ → CUSTOM_DOMAIN_A_TARGET
# Subdomain (king.yourbrand.com, www.yourbrand.com): CNAME → CUSTOM_DOMAIN_CNAME_TARGET
# Cloudflare for SaaS issues HTTPS automatically when CLOUDFLARE_* vars are set.
# See docs/custom-domains-production.md
#
CUSTOM_DOMAIN_A_TARGET="69.46.46.90"
CUSTOM_DOMAIN_CNAME_TARGET=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
# Optional: account-wide token for auto-adding customer DNS (Zone DNS Edit on All zones).
# Use this when customer domains (e.g. keysfashionshop.com) are in the same Cloudflare
# account but CLOUDFLARE_API_TOKEN is limited to mindflo.today only.
CLOUDFLARE_DNS_API_TOKEN=""
CLOUDFLARE_SSL_VALIDATION_METHOD="http"

# One-click "Connect Cloudflare" for customers (no API token paste).
# MULTI-TENANT: each customer authorizes THEIR Cloudflare account via OAuth.
# Platform CLOUDFLARE_API_TOKEN is for SaaS custom hostnames (your zone) ONLY —
# it must NOT write customer DNS (default). Set ALLOW_PLATFORM_CUSTOMER_DNS=true
# only for legacy same-account testing.
# Create at Cloudflare → Manage Account → OAuth clients (public client).
# Scopes on the OAuth client: Zone Read + DNS Write (grant_types include refresh_token).
# Request IDs must be: zone.read dns.write — NOT zone.dns.write (Cloudflare rejects that).
# Redirect URI must match exactly:
#   https://keylink360.mindflo.today/api/domains/providers/cloudflare/oauth/callback
CLOUDFLARE_OAUTH_CLIENT_ID=""
CLOUDFLARE_OAUTH_CLIENT_SECRET=""
CLOUDFLARE_OAUTH_REDIRECT_URI=""
# Optional space-separated scope IDs (defaults: zone.read dns.write):
# CLOUDFLARE_OAUTH_SCOPES="zone.read dns.write"
# ALLOW_PLATFORM_CUSTOMER_DNS="false"
# Orange-cloud on customer CNAME (usually leave false for CF-for-SaaS):
# CLOUDFLARE_CUSTOMER_CNAME_PROXIED="false"

# Optional SMTP — when set, verification & reset emails are delivered for real.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="KEYLINK360 <noreply@keylink360.mindflo.today>"

# --- Vercel (frontend build) ---
# Railway public URL (no trailing slash). Required on Vercel so UI calls the API.
# VITE_API_URL="https://keylink360-production.up.railway.app"
# true  = always use client preview login
# false = never fall back to preview (real API only)
# unset = auto: preview when /api/auth is unreachable
# VITE_AUTH_PREVIEW=false

# Platform Razorpay (Form → Pay → Thank You on public bio pages & Subscription Billing)
# Create keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional real OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
